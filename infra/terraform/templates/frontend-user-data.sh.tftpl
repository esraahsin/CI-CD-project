#!/bin/bash -e

export AWS_REGION="${aws_region}"

dnf update -y
dnf install -y git nginx
curl -fsSL https://rpm.nodesource.com/setup_20.x | bash -
dnf install -y nodejs

systemctl enable nginx

APP_DIR="/home/ec2-user/app"

mkdir -p "$APP_DIR"
chown ec2-user:ec2-user "$APP_DIR"

if [ ! -d "$APP_DIR/.git" ]; then
  sudo -u ec2-user git clone --branch "${repo_branch}" "${repo_url}" "$APP_DIR"
else
  cd "$APP_DIR"
  sudo -u ec2-user git fetch --all
  sudo -u ec2-user git reset --hard "origin/${repo_branch}"
fi

cd "$APP_DIR/${frontend_path}"

sudo -u ec2-user npm install
sudo -u ec2-user npm run build

rm -rf /usr/share/nginx/html/*  # Clear existing content before copying new build files

BUILD_OUTPUT="$APP_DIR/${frontend_path}/${frontend_build_output_path}" # angular gonna put the compiled files in this folder(they r generated by npm run build)

cp -r "$BUILD_OUTPUT"/* /usr/share/nginx/html/ # we copy the content build in nginx so it can serve the static files to the users (navigateur qui va executer le code js et afficher le html/css)

cat > /usr/share/nginx/html/runtime-config.js <<RUNTIME
window.__API_URL__ = ${backend_api_url_json};     #we pass the alb to the front
RUNTIME

cat > /etc/nginx/conf.d/frontend.conf <<'NGINX'
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;# it s going to return the index.html for any route that is not found, so no 404 error
  }
}
NGINX

systemctl restart nginx