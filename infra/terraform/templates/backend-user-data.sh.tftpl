#!/bin/bash -e 
#-e if the shell script has an error it s gonna stop the execution immediately

export AWS_REGION="${aws_region}"

dnf update -y #-y so we answer yes to all questions during the installation process
dnf install -y git 
curl -fsSL https://rpm.nodesource.com/setup_20.x | bash -
# no node.js in the default amazon linux 2023 repository, so we need to add the nodesource repository to install node.js
# -f fail silently(no output at all) on HTTP errors, -s silent mode(no progression seen yet print errors we need to see), -S show error if it fails, -L follow redirects
dnf install -y nodejs
npm install -g pm2 # process manager for node js app to keep them alive 

APP_DIR="/home/ec2-user/app"
mkdir -p "$APP_DIR"
chown ec2-user:ec2-user "$APP_DIR"

if [ ! -d "$APP_DIR/.git" ]; then
  sudo -u ec2-user git clone --branch "${repo_branch}" "${repo_url}" "$APP_DIR"
else
  cd "$APP_DIR"
  sudo -u ec2-user git fetch --all
  sudo -u ec2-user git reset --hard "origin/${repo_branch}"
fi

cd "$APP_DIR/${backend_path}"

ENV_FILE="$APP_DIR/${backend_path}/.env"

cat > "$ENV_FILE" <<ENVFILE
PORT=${backend_port}
USE_JSON_STORAGE=${use_json_storage}
ENVFILE

if [ "${use_json_storage}" = "false" ]; then
  if [ "${use_ssm_parameters}" = "true" ]; then
    DB_HOST=$(aws ssm get-parameter --name "${ssm_parameter_path}/DB_HOST" --with-decryption --query "Parameter.Value" --output text) || { echo "Failed to retrieve DB_HOST from SSM." >&2; exit 1; }

    DB_USER=$(aws ssm get-parameter --name "${ssm_parameter_path}/DB_USER" --with-decryption --query "Parameter.Value" --output text) || { echo "Failed to retrieve DB_USER from SSM." >&2; exit 1; }

    DB_PASSWORD=$(aws ssm get-parameter --name "${ssm_parameter_path}/DB_PASSWORD" --with-decryption --query "Parameter.Value" --output text) || { echo "Failed to retrieve DB_PASSWORD from SSM." >&2; exit 1; }

    DB_NAME=$(aws ssm get-parameter --name "${ssm_parameter_path}/DB_NAME" --with-decryption --query "Parameter.Value" --output text) || { echo "Failed to retrieve DB_NAME from SSM." >&2; exit 1; }
  else
    DB_HOST="${db_host}"
    DB_USER="${db_user}"
    DB_NAME="${db_name}"

    if [ -n "${db_password_secret_arn}" ]; then
      DB_PASSWORD=$(aws secretsmanager get-secret-value --secret-id "${db_password_secret_arn}" --query "SecretString" --output text) || { echo "Failed to retrieve DB password from Secrets Manager." >&2; exit 1; }
    fi
  fi

  if [ -z "$DB_PASSWORD" ]; then
    echo "DB_PASSWORD must be provided via SSM or Secrets Manager." >&2
    exit 1
  fi

  cat >> "$ENV_FILE" <<ENVFILE
DB_HOST=$DB_HOST
DB_USER=$DB_USER
DB_PASSWORD=$DB_PASSWORD
DB_NAME=$DB_NAME
ENVFILE
fi

chown ec2-user:ec2-user "$ENV_FILE"

sudo -u ec2-user npm install

#
sudo -u ec2-user pm2 start "$APP_DIR/${backend_path}/index.js" --name backend

sudo env PATH=$PATH:/usr/bin pm2 startup systemd -u ec2-user --hp /home/ec2-user

sudo -u ec2-user pm2 save