#!/bin/bash -e

export AWS_REGION="${aws_region}"

yum update -y
yum install -y git nginx awscli
curl -fsSL https://rpm.nodesource.com/setup_20.x | bash -
yum install -y nodejs
npm install -g pm2

systemctl enable nginx
cat > /etc/nginx/conf.d/backend.conf <<'NGINX'
server {
  listen 80;
  server_name _;

  location / {
    proxy_pass http://localhost:${backend_port};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_cache_bypass $http_upgrade;
  }
}
NGINX
systemctl restart nginx

APP_DIR="/home/ec2-user/app"
mkdir -p "$APP_DIR"
chown ec2-user:ec2-user "$APP_DIR"

if [ ! -d "$APP_DIR/.git" ]; then
  sudo -u ec2-user git clone --branch "${repo_branch}" "${repo_url}" "$APP_DIR"
else
  cd "$APP_DIR"
  sudo -u ec2-user git fetch --all
  sudo -u ec2-user git reset --hard "origin/${repo_branch}"
fi

cd "$APP_DIR/${backend_path}"

ENV_FILE="$APP_DIR/${backend_path}/.env"
cat > "$ENV_FILE" <<ENVFILE
PORT=${backend_port}
USE_JSON_STORAGE=${use_json_storage}
ENVFILE

if [ "${use_json_storage}" = "false" ]; then
  if [ "${use_ssm_parameters}" = "true" ]; then
    DB_HOST=$(aws ssm get-parameter --name "${ssm_parameter_path}/DB_HOST" --with-decryption --query "Parameter.Value" --output text)
    DB_USER=$(aws ssm get-parameter --name "${ssm_parameter_path}/DB_USER" --with-decryption --query "Parameter.Value" --output text)
    DB_PASSWORD=$(aws ssm get-parameter --name "${ssm_parameter_path}/DB_PASSWORD" --with-decryption --query "Parameter.Value" --output text)
    DB_NAME=$(aws ssm get-parameter --name "${ssm_parameter_path}/DB_NAME" --with-decryption --query "Parameter.Value" --output text)
  else
    DB_HOST="${db_host}"
    DB_USER="${db_user}"
    DB_NAME="${db_name}"
  fi

  if [ -n "${db_password_secret_arn}" ]; then
    DB_PASSWORD=$(aws secretsmanager get-secret-value --secret-id "${db_password_secret_arn}" --query "SecretString" --output text)
  fi

  if [ -z "$DB_PASSWORD" ]; then
    echo "DB_PASSWORD must be provided via SSM or Secrets Manager." >&2
    exit 1
  fi

  cat >> "$ENV_FILE" <<ENVFILE
DB_HOST=$${DB_HOST}
DB_USER=$${DB_USER}
DB_PASSWORD=$${DB_PASSWORD}
DB_NAME=$${DB_NAME}
ENVFILE
fi

chown ec2-user:ec2-user "$ENV_FILE"

sudo -u ec2-user npm install
sudo -u ec2-user pm2 start "$APP_DIR/${backend_path}/index.js" --name backend
sudo env PATH=$PATH:/usr/bin pm2 startup systemd -u ec2-user --hp /home/ec2-user
sudo -u ec2-user pm2 save
